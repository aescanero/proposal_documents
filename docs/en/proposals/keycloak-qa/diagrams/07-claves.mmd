    end

    subgraph SM["Secret Manager · disasterproject-qa"]
        S1[("qa-keycloak-realm-signing<br/>private key + certificate")]
        S2[("qa-keycloak-entra-cert<br/>private key + certificate")]
    end

    subgraph GIT["Git · instance.tm.hcl"]
        C1["saml_idp_certificate<br/>PUBLIC certificate"]
    end

    subgraph K["Keycloak · realm qa"]
        KP1["rsa key provider<br/>signs SAML and tokens"]
        KP2["IdP entra<br/>private_key_jwt"]
    end

    ENTRA["Entra ID<br/>app registration keycloak-qa<br/>several certificates at once"]
    SQ["SonarQube<br/>sonar.auth.saml.certificate.secured"]
    X509["x509-certificate-exporter<br/>alert at 30 days (R42)"]

    GEN --> S1
    GEN --> S2
    GEN -->|"public certificate"| C1
