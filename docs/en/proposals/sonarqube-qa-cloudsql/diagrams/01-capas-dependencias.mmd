        CO["cloud-observability<br/>audit + <b>notification channel</b>"]
    end
    subgraph L2["Layer 2 · runtime"]
        CL["cluster: gke (Standard)<br/>node pool 'sonar' with sysctl"]
    end
    subgraph L2B["Layer 2b"]
        POL["policy-gatekeeper"]
    end
    subgraph L3["Layer 3 · platform services"]
        ING["ingress · certs · secrets · monitoring<br/>unchanged"]
    end
