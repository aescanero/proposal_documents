flowchart TB
    R["A tenant's HTTPRoute"]
    Q1{"namespace labelled<br/>gateway.disasterproject.com/routes?"}
    Q2{"hostnames non-empty,<br/>no wildcard?"}
    Q3{"hostnames in the namespace<br/>annotation (claims)?"}
    Q4{"host free in<br/>other namespaces?"}
    Q5{"parentRefs to Gateway qa<br/>and own backendRefs?"}
    OK["Accepted by the Gateway"]
    NO1["Ignored: allowedRoutes"]
    NO2["Denied at admission<br/>(Gatekeeper)"]
    G1["G1 in the PR: the hostname<br/>is a claim of the instance"]

    R --> Q1
    Q1 -->|no| NO1
    Q1 -->|yes| Q2
    Q2 -->|no| NO2
    Q2 -->|yes| Q3
    Q3 -->|no| NO2
    Q3 -->|yes| Q4
    Q4 -->|no| NO2
    Q4 -->|yes| Q5
    Q5 -->|no| NO2
    Q5 -->|yes| OK
    G1 -. "before merge" .-> R

    subgraph RES["Reserved to envoy-gateway-system"]
        direction LR
        K1["Gateway"]
        K2["ClientTrafficPolicy"]
        K3["EnvoyProxy"]
        K4["EnvoyExtensionPolicy"]
    end
    subgraph OFF["Disabled in the controller"]
        direction LR
        K5["EnvoyPatchPolicy"]
        K6["Backend"]
    end

    style NO1 fill:#fce8e6
    style NO2 fill:#fce8e6
    style OK fill:#e6f4ea
    style RES fill:#f5f5f5
    style OFF fill:#fce8e6
