# Destination: ci/federation.env — the federation's coordinates (landing-zone-qa DZ12)
# Identifiers, not secrets: access is granted by each identity's binding to
# attribute.environment/<env>, which only a job behind that GitHub Environment obtains.
# Written once from the bootstrap's outputs (landing-zone-qa §1.3); reviewed by security.
GCP_LZ_PROJECT=disasterproject-lz
GCP_LZ_PROJECT_NUMBER=000000000000   # replace with the bootstrap output (§1.5: a marked placeholder)
GCP_WIF_POOL=gh-disasterproject-infra
GCP_WIF_PROVIDER_ID=github-oidc
