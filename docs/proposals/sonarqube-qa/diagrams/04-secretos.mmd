flowchart LR
    subgraph CLOUD["Cloud"]
        KMS["KMS<br/>clave de auto-unseal"]
    end
    subgraph BAO["ns openbao"]
        OB[("OpenBao · Raft x3<br/>kv-v2: qa/sonarqube/*")]
        KA["auth/kubernetes<br/>rol sonarqube-eso<br/>bound ns=sonarqube, sa=eso-sonarqube"]
    end
    subgraph ESO["ns external-secrets"]
        OP["ESO controller"]
    end
    subgraph NS["ns sonarqube"]
        SS["SecretStore<br/>(namespaced, no Cluster-)"]
        ES["ExternalSecret x5"]
        K1["Secret sonarqube-db<br/>usuario + password JDBC"]
        K2["Secret sonarqube-passcode<br/>monitoring passcode"]
        K3["Secret sonarqube-admin<br/>password admin inicial"]
        K4["Secret sonarqube-secret-key<br/>sonar-secret.txt"]
        K5["Secret sonarqube-saml<br/>cert IdP + clave SP"]
        CNPG["CNPG Cluster<br/>bootstrap.initdb.secret"]
        SQ["SonarQube pod"]
        PM["PodMonitor<br/>header X-Sonar-Passcode"]
    end

    KMS -->|"unseal"| OB
    OP --> SS
    SS -->|"token SA → login"| KA
    KA --> OB
    SS --> ES
    ES --> K1 & K2 & K3 & K4 & K5
    K1 --> CNPG
    K1 --> SQ
    K2 --> SQ
    K2 --> PM
    K3 --> SQ
    K4 --> SQ
    K5 --> SQ

    NOTE["Nunca por outputs sharing:<br/>solo se comparten rutas kv<br/>(qa/sonarqube/db), no valores"]
