flowchart TD
    subgraph P["Plataforma qa — despliegue escalonado, mocks OFF"]
        direction TB
        N["{cloud}-qa-network"] --> C["{cloud}-qa-cluster<br/>incluye node pool 'sonar'"]
        N --> CM["{cloud}-qa-cloudmon"]
        C --> PO["{cloud}-qa-policy<br/>Gatekeeper"]
        PO --> S1["{cloud}-qa-secrets<br/>OpenBao + ESO"]
        PO --> M["{cloud}-qa-monitoring"]
        PO --> CE["{cloud}-qa-certs"]
        PO --> DN["{cloud}-qa-dns"]
        CE --> GW["{cloud}-qa-gateway"]
        GW -. "handle de borde" .-> ED["{cloud}-qa-edge<br/>(capa 1, se aplica después)"]
        S1 --> DB["{cloud}-qa-postgres-operator<br/>CloudNativePG"]
        M --> DB
        DB --> KC["{cloud}-qa-keycloak"]
        S1 --> KC
        GW --> KC
    end

    subgraph I["Instancia sonarqube-main — una ejecución ordenada"]
        direction TB
        IAM["iam<br/>SA + identidad de workload<br/>(backup a bucket)"] --> SEC["secrets<br/>ExternalSecrets"]
        IAM --> DATA["data-tenant<br/>CNPG Cluster + ScheduledBackup"]
        SEC --> DATA
        DATA --> FW["firewall<br/>NetworkPolicies"]
        FW --> APP["app<br/>helm_release sonarqube"]
        SEC --> APP
        APP --> SSO["sso<br/>cliente SAML en Keycloak"]
        APP --> FD["frontdoor<br/>HTTPRoute + Certificate"]
        APP --> OBS["observability<br/>PodMonitor + PrometheusRule<br/>+ dashboard"]
    end

    KC --> SSO
    S1 --> SEC
    DB --> DATA
    GW --> FD
    M --> OBS

    style ED fill:#f5f5f5
    style APP fill:#e8f5e9
