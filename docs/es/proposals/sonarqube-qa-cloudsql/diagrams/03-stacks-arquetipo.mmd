flowchart TB
    subgraph PLAT["Productores de plataforma (qa)"]
        NET["gcp-qa-network<br/>(globals: VPC, rango PSA)"]
        GKE["gcp-qa-gke<br/>endpoint · CA · WI pool"]
        CMON["gcp-qa-cloudmon<br/>notification_channel_id"]
        KC["gcp-qa-keycloak<br/>saml_sso_url · saml_idp_certificate"]
        GW["gcp-qa-gateway<br/>(globals)"]
        MON["gcp-qa-monitoring<br/>(global: rules_selector)"]
    end

    subgraph INST["Instancia gcp-qa-sonarqube-main"]
        IAM["iam<br/>namespace · KSAs"]
        SEC["secrets<br/>Secret Manager · IAM por secreto<br/>SecretStore · ExternalSecrets"]
        DATA["<b>data</b> (solo GCP)<br/>Cloud SQL · BD · usuario<br/>versión de qa-sonarqube-db<br/>cloudsql.client con condición · alertas"]
        SKIP["data-tenant<br/><i>omitido: database-platform sin enlazar</i>"]
        FW["firewall<br/>NetworkPolicies"]
        SSO["sso<br/>ConfigMap client-sonarqube-main-*"]
        APP["app<br/>helm_release sonarqube<br/>+ sidecar Cloud SQL Auth Proxy"]
        CFG["config"]
        FD["frontdoor"]
        OBS["observability"]
    end

    IAM --> SEC --> DATA --> FW --> APP
    IAM --> DATA
    IAM --> SSO --> APP
    SEC --> APP
    APP --> CFG
    APP --> FD
    APP --> OBS

    NET -. "after, sin input" .-> DATA
    GKE -. "sharing + after" .-> IAM
    GKE -.-> SEC
    GKE -. "workload_identity_pool" .-> DATA
    CMON -. "sharing + after" .-> DATA
    KC -. "sharing + after" .-> APP
    GW -. "global" .-> FD
    MON -. "global" .-> OBS

    style SKIP fill:#f5f5f5,stroke-dasharray: 5 5
