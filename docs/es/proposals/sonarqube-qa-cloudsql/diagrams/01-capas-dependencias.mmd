flowchart BT
    subgraph L0["Capa 0 · proyecto de landing zone"]
        DZ["dns-zone<br/>disasterproject.com, delega qa.disasterproject.com"]
        CP["cidr-pool<br/>10.0.0.0/8"]
        KMS["Cloud KMS"]
        AR["Artifact Registry<br/>+ imagen de Cloud SQL Auth Proxy"]
    end
    subgraph L1["Capa 1 · environment qa · proyecto disasterproject-qa"]
        NET["network<br/>/17 · Private Google Access<br/><b>PSA: rango qa-psa en zona data</b>"]
        EE["env-edge · cert · waf · edge-ip<br/>sin cambios"]
    end
    subgraph L1B["Capa 1b"]
        CO["cloud-observability<br/>auditoría + <b>canal de notificación</b>"]
    end
    subgraph L2["Capa 2 · runtime"]
        CL["cluster: gke (Standard)<br/>node pool 'sonar' con sysctl"]
    end
    subgraph L2B["Capa 2b"]
        POL["policy-gatekeeper"]
    end
    subgraph L3["Capa 3 · platform services"]
        ING["ingress · certs · secrets · monitoring<br/>sin cambios"]
    end
    subgraph L4["Capa 4 · middleware"]
        DBP["database-platform<br/><b>SIN ENLAZAR en qa</b><br/>no se despliega CloudNativePG"]
        IDP["oidc-idp<br/>Keycloak + su propio Cloud SQL"]
    end
    subgraph L5["Capa 5 · sonarqube"]
        SQ["sonarqube 0.2.0"]
        DATA["stack data<br/>condition: !resolved(database-platform)<br/><b>Cloud SQL for PostgreSQL dedicado</b>"]
    end

    CP --> NET
    NET --> CO
    NET --> CL
    NET --> EE
    CL --> POL --> ING
    KMS --> CL
    ING --> IDP
