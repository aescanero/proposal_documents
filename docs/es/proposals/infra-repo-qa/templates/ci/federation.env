# Destino: ci/federation.env — las coordenadas de la federación (landing-zone-qa DZ12)
# Identificadores, no secretos: el acceso lo da el vínculo de cada identidad con
# attribute.environment/<env>, que solo obtiene un job detrás de ese GitHub Environment.
# Se escribe una vez desde las salidas del bootstrap (landing-zone-qa §1.3); lo revisa seguridad.
GCP_LZ_PROJECT=disasterproject-lz
GCP_LZ_PROJECT_NUMBER=000000000000   # sustituir por la salida del bootstrap (§1.5: un marcador señalado)
GCP_WIF_POOL=gh-disasterproject-infra
GCP_WIF_PROVIDER_ID=github-oidc
