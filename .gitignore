# OpenTofu / Terraform
.terraform/
.tofu/
*.tfstate
*.tfstate.*
*.tfplan
out.tfplan
plan.json
crash.log
override.tf
override.tf.json
*_override.tf
.terraform.lock.hcl.bak

# Plugin cache (path comes from terramate.tm.hcl run.env)
.tofu-plugin-cache/

# Terramate
.terramate/
.terramate-cache/

# Resolver intermediates — regenerate, never commit
resolution.json
stacks.json

# registry/registry.json is NOT an intermediate: it is generated from
# registry/*.yaml by tools/registry-generate and IS committed, the way generated
# .tf is. `registry-generate --check` has to have something to compare against,
# and `conftest --data registry/` has to find it on a fresh checkout.

# Credentials — never
*.pem
*.key
*_rsa
credentials.json
service-account*.json
.env
.envrc

# Tooling
.mise/
node_modules/
__pycache__/
.venv/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
