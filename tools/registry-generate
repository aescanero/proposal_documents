#!/usr/bin/env python3
"""Generate the three registry artefacts from registry/*.yaml.

`registry/*.yaml` is the single source of truth for capabilities, traits, pool
zone names and mandatory labels. Three artefacts are generated from it:

    registry/capabilities.yaml ─┐
    registry/traits.yaml        ├─> schemas/archetype-manifest.schema.json
    registry/zones.yaml         │      $defs.capability.enum
    registry/labels.yaml       ─┤      $defs.trait.enum          (check-jsonschema)
                                │
                                ├─> registry/registry.json       (conftest --data)
                                │
                                └─> charts/policy-gatekeeper/values.registry.yaml
                                                                 (ConstraintTemplate params)

Drift between them is risk R34: a label the generator stopped emitting while the
admission Constraint still demands it blocks legitimate deployments at admission,
which is the worst possible place to find out. `--check` is therefore a blocking
CI gate, exactly like `terramate generate --check`.

    tools/registry-generate            regenerate the three artefacts in place
    tools/registry-generate --check    fail if any differ; write nothing

Exit codes: 0 up to date / written · 1 drift under --check · 2 bad source.

Two things worth knowing before editing this file:

*   **Only the two enum arrays are touched in the schema.** The file is edited as
    text, not re-serialised, so key order, indentation, the `\\u2014` escapes and
    the absent trailing newline all survive untouched. `_member_span` is a
    minimal JSON scanner that exists solely to locate those two arrays.

*   **Enum members are sorted.** The registry source groups capabilities by layer
    and traits by domain, which is how humans read it; the enums are sorted so
    that adding a capability produces a one-line diff wherever it lands in the
    source.
"""

from __future__ import annotations

import argparse
import difflib
import json
import re
import sys
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover - environment problem, not a source problem
    sys.exit("registry-generate: PyYAML is required (pip install pyyaml)")

REPO_ROOT = Path(__file__).resolve().parent.parent

# Default artefact locations, relative to the repository root.
DEFAULT_REGISTRY_DIR = "registry"
DEFAULT_SCHEMA = "schemas/archetype-manifest.schema.json"
DEFAULT_BUNDLE = "registry/registry.json"
DEFAULT_GATEKEEPER_VALUES = "charts/policy-gatekeeper/values.registry.yaml"

# Capabilities, traits and zone names are slugs. Anything else is a typo that
# would silently match nothing downstream.
SLUG = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
FRACTION = re.compile(r"^/(?:[0-9]|[12][0-9]|3[0-2])$")
# Kubernetes label key: optional DNS-subdomain prefix, then a name segment.
LABEL_KEY = re.compile(
    r"^(?:[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?/)?"
    r"[A-Za-z0-9](?:[-A-Za-z0-9_.]*[A-Za-z0-9])?$"
)

GENERATED_BY = "tools/registry-generate"


class SourceError(Exception):
    """The registry YAML is wrong. Not a drift; the input needs fixing."""


# --------------------------------------------------------------------------- #
# Reading and validating the registry
# --------------------------------------------------------------------------- #


def _load_yaml(path: Path) -> dict:
    if not path.is_file():
        raise SourceError(f"{path}: missing")
    try:
        doc = yaml.safe_load(path.read_text(encoding="utf-8"))
    except yaml.YAMLError as exc:
        raise SourceError(f"{path}: {exc}") from exc
    if not isinstance(doc, dict):
        raise SourceError(f"{path}: expected a mapping at the top level")
    return doc


def _slug_list(doc: dict, key: str, where: Path) -> list[str]:
    values = doc.get(key)
    if not isinstance(values, list) or not values:
        raise SourceError(f"{where}: '{key}' must be a non-empty list")
    seen: set[str] = set()
    for value in values:
        if not isinstance(value, str) or not SLUG.match(value):
            raise SourceError(f"{where}: {value!r} is not a lower-case slug")
        if value in seen:
            raise SourceError(f"{where}: {value!r} is listed twice")
        seen.add(value)
    return sorted(values)


def _zones(doc: dict, where: Path) -> list[dict]:
    zones = doc.get("zones")
    if not isinstance(zones, list) or not zones:
        raise SourceError(f"{where}: 'zones' must be a non-empty list")

    out: list[dict] = []
    seen: set[str] = set()
    for zone in zones:
        if not isinstance(zone, dict):
            raise SourceError(f"{where}: every zone must be a mapping")
        name = zone.get("name")
        if not isinstance(name, str) or not SLUG.match(name):
            raise SourceError(f"{where}: zone name {name!r} is not a lower-case slug")
        if name in seen:
            raise SourceError(f"{where}: zone {name!r} is listed twice")
        seen.add(name)

        fraction = zone.get("fraction")
        if not isinstance(fraction, str) or not FRACTION.match(fraction):
            raise SourceError(
                f"{where}: zone {name!r} fraction {fraction!r} is not a prefix like '/20'"
            )

        allocatable = zone.get("allocatable")
        if not isinstance(allocatable, bool):
            raise SourceError(f"{where}: zone {name!r} needs allocatable: true|false")

        purposes = zone.get("purposes", [])
        if purposes is None:
            purposes = []
        if not isinstance(purposes, list):
            raise SourceError(f"{where}: zone {name!r} purposes must be a list")
        for purpose in purposes:
            if not isinstance(purpose, str) or not SLUG.match(purpose):
                raise SourceError(
                    f"{where}: zone {name!r} purpose {purpose!r} is not a lower-case slug"
                )
        if allocatable and not purposes:
            raise SourceError(f"{where}: allocatable zone {name!r} declares no purposes")
        if not allocatable and purposes:
            raise SourceError(
                f"{where}: zone {name!r} is not allocatable but declares purposes"
            )

        unknown = set(zone) - {"name", "fraction", "allocatable", "purposes"}
        if unknown:
            raise SourceError(f"{where}: zone {name!r} has unknown keys {sorted(unknown)}")

        # purposes is normalised to a list so Rego need not test for the key.
        out.append(
            {
                "name": name,
                "fraction": fraction,
                "allocatable": allocatable,
                "purposes": sorted(purposes),
            }
        )

    return sorted(out, key=lambda z: z["name"])


def _labels(doc: dict, where: Path) -> dict[str, dict[str, list[str]]]:
    labels = doc.get("labels")
    if not isinstance(labels, dict) or not labels:
        raise SourceError(f"{where}: 'labels' must be a non-empty mapping")

    out: dict[str, dict[str, list[str]]] = {}
    for target, spec in sorted(labels.items()):
        if not isinstance(target, str) or not re.match(r"^[a-z0-9_]+$", target):
            raise SourceError(f"{where}: label target {target!r} is not a snake_case name")
        if not isinstance(spec, dict):
            raise SourceError(f"{where}: label target {target!r} must be a mapping")

        unknown = set(spec) - {"required", "optional"}
        if unknown:
            raise SourceError(
                f"{where}: label target {target!r} has unknown keys {sorted(unknown)}"
            )

        buckets: dict[str, list[str]] = {}
        for bucket in ("required", "optional"):
            keys = spec.get(bucket, [])
            if keys is None:
                keys = []
            if not isinstance(keys, list):
                raise SourceError(f"{where}: {target}.{bucket} must be a list")
            seen: set[str] = set()
            for key in keys:
                if not isinstance(key, str) or not LABEL_KEY.match(key):
                    raise SourceError(f"{where}: {target}.{bucket}: {key!r} is not a label key")
                if key in seen:
                    raise SourceError(f"{where}: {target}.{bucket}: {key!r} is listed twice")
                seen.add(key)
            # Sorted: a required label must be emitted, an optional one may be.
            # Which bucket a key sits in is the whole meaning of the file.
            buckets[bucket] = sorted(keys)

        both = set(buckets["required"]) & set(buckets["optional"])
        if both:
            raise SourceError(
                f"{where}: {target}: {sorted(both)} listed as both required and optional"
            )
        if not buckets["required"]:
            raise SourceError(f"{where}: {target}: no required labels")

        out[target] = buckets

    return out


def read_registry(registry_dir: Path) -> dict:
    """Parse and validate registry/*.yaml into one normalised document."""
    capabilities_file = registry_dir / "capabilities.yaml"
    traits_file = registry_dir / "traits.yaml"
    zones_file = registry_dir / "zones.yaml"
    labels_file = registry_dir / "labels.yaml"

    return {
        "capabilities": _slug_list(_load_yaml(capabilities_file), "capabilities", capabilities_file),
        "traits": _slug_list(_load_yaml(traits_file), "traits", traits_file),
        "zones": _zones(_load_yaml(zones_file), zones_file),
        "labels": _labels(_load_yaml(labels_file), labels_file),
    }


# --------------------------------------------------------------------------- #
# A minimal JSON scanner — locates a value's span without reformatting the file
# --------------------------------------------------------------------------- #

_WS = " \t\r\n"


def _skip_ws(text: str, i: int) -> int:
    while i < len(text) and text[i] in _WS:
        i += 1
    return i


def _string_end(text: str, i: int) -> int:
    if text[i] != '"':
        raise SourceError(f"malformed JSON at offset {i}: expected a string")
    i += 1
    while i < len(text):
        if text[i] == "\\":
            i += 2
            continue
        if text[i] == '"':
            return i + 1
        i += 1
    raise SourceError("malformed JSON: unterminated string")


def _value_end(text: str, i: int) -> int:
    char = text[i]
    if char == '"':
        return _string_end(text, i)
    if char in "{[":
        close = "}" if char == "{" else "]"
        i += 1
        while True:
            i = _skip_ws(text, i)
            if i >= len(text):
                raise SourceError("malformed JSON: unterminated container")
            if text[i] == close:
                return i + 1
            if text[i] in ",:":
                i += 1
                continue
            i = _value_end(text, i)
    j = i
    while j < len(text) and text[j] not in ",}] \t\r\n":
        j += 1
    return j


def _member_span(text: str, i: int, key: str) -> tuple[int, int]:
    """Span of object member `key`, where text[i] opens the object."""
    if text[i] != "{":
        raise SourceError(f"malformed JSON at offset {i}: expected an object")
    i = _skip_ws(text, i + 1)
    if text[i] == "}":
        raise SourceError(f"key {key!r} not found")
    while True:
        i = _skip_ws(text, i)
        name_end = _string_end(text, i)
        name = json.loads(text[i:name_end])
        i = _skip_ws(text, name_end)
        if text[i] != ":":
            raise SourceError(f"malformed JSON at offset {i}: expected ':'")
        value_start = _skip_ws(text, i + 1)
        value_end = _value_end(text, value_start)
        if name == key:
            return value_start, value_end
        i = _skip_ws(text, value_end)
        if text[i] != ",":
            raise SourceError(f"key {key!r} not found")
        i += 1


def find_span(text: str, path: list[str]) -> tuple[int, int]:
    """Span of the value at `path`, e.g. ["$defs", "capability", "enum"]."""
    start = _skip_ws(text, 0)
    end = len(text)
    for key in path:
        start, end = _member_span(text, start, key)
    return start, end


# --------------------------------------------------------------------------- #
# Rendering
# --------------------------------------------------------------------------- #


def _render_enum(values: list[str], text: str, start: int) -> str:
    """Render a JSON array at the indentation of the line it starts on."""
    line_start = text.rfind("\n", 0, start) + 1
    prefix = text[line_start:start]
    indent = prefix[: len(prefix) - len(prefix.lstrip())]
    if not values:
        return "[]"
    items = ",\n".join(f"{indent}  {json.dumps(v)}" for v in values)
    return f"[\n{items}\n{indent}]"


def render_schema(registry: dict, current: str) -> str:
    """Replace only $defs.capability.enum and $defs.trait.enum. Nothing else."""
    text = current
    # Each span is located afresh against the text as it stands, so the two
    # replacements cannot invalidate one another's offsets.
    for def_name, key in (("trait", "traits"), ("capability", "capabilities")):
        start, end = find_span(text, ["$defs", def_name, "enum"])
        text = text[:start] + _render_enum(registry[key], text, start) + text[end:]
    return text


def render_bundle(registry: dict) -> str:
    """The conftest --data document. `registry/registry.json` → `data.registry`."""
    bundle = {
        "_generated": f"by {GENERATED_BY} from registry/*.yaml — do not edit by hand",
        "capabilities": registry["capabilities"],
        "traits": registry["traits"],
        "zones": registry["zones"],
        "zone_names": [z["name"] for z in registry["zones"]],
        "labels": registry["labels"],
    }
    return json.dumps(bundle, indent=2, ensure_ascii=False) + "\n"


def _yaml_scalar(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    return json.dumps(value, ensure_ascii=False)


def _yaml_list(values: list, indent: str) -> list[str]:
    if not values:
        return [" []"]
    return ["\n"] + [f"{indent}- {_yaml_scalar(v)}\n" for v in values]


def render_gatekeeper_values(registry: dict) -> str:
    """Registry-derived ConstraintTemplate parameters, merged over the chart's own values."""
    out: list[str] = [
        f"# GENERATED by {GENERATED_BY} from registry/*.yaml — DO NOT EDIT BY HAND.\n",
        "#\n",
        "# Registry-derived ConstraintTemplate parameters only. The chart's own values\n",
        "# (replicas, failurePolicy, exemptNamespaces, enforcementAction) stay in\n",
        "# values.yaml; this file is merged after it:\n",
        "#\n",
        "#   helm upgrade --install policy-gatekeeper charts/policy-gatekeeper \\\n",
        "#     -f charts/policy-gatekeeper/values.yaml \\\n",
        "#     -f charts/policy-gatekeeper/values.registry.yaml\n",
        "#\n",
        "# The generator emits these labels; Gatekeeper validates them. There is no\n",
        "# mutation: one writer, one validator. Drift between the two blocks legitimate\n",
        "# deployments at admission (risk R34), which is why registry-generate --check\n",
        "# is a blocking gate.\n",
        "\n",
        "registry:\n",
        "  capabilities:",
    ]
    out += _yaml_list(registry["capabilities"], "    ")
    out += ["  traits:"]
    out += _yaml_list(registry["traits"], "    ")
    out += ["  zones:"]
    out += _yaml_list([z["name"] for z in registry["zones"]], "    ")
    out += ["  labels:\n"]
    for target, buckets in registry["labels"].items():
        out += [f"    {target}:\n"]
        for bucket in ("required", "optional"):
            out += [f"      {bucket}:"]
            out += _yaml_list(buckets[bucket], "        ")
    return "".join(out)


# --------------------------------------------------------------------------- #
# Driving
# --------------------------------------------------------------------------- #


def _diff(path: Path, current: str, wanted: str) -> str:
    return "".join(
        difflib.unified_diff(
            current.splitlines(keepends=True),
            wanted.splitlines(keepends=True),
            fromfile=f"{path} (committed)",
            tofile=f"{path} (generated)",
        )
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="registry-generate",
        description="Generate the schema enums, conftest bundle and Gatekeeper values "
        "from registry/*.yaml.",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="fail if a generated artefact differs from the committed one; write nothing",
    )
    parser.add_argument("--registry", default=DEFAULT_REGISTRY_DIR, help="registry source directory")
    parser.add_argument("--schema", default=DEFAULT_SCHEMA, help="archetype manifest schema")
    parser.add_argument("--bundle", default=DEFAULT_BUNDLE, help="conftest --data bundle")
    parser.add_argument(
        "--gatekeeper-values", default=DEFAULT_GATEKEEPER_VALUES, help="Gatekeeper chart values"
    )
    parser.add_argument("--root", default=str(REPO_ROOT), help="repository root")
    parser.add_argument("-q", "--quiet", action="store_true", help="only report problems")
    args = parser.parse_args(argv)

    root = Path(args.root)

    def resolve(value: str) -> Path:
        path = Path(value)
        return path if path.is_absolute() else root / path

    schema_path = resolve(args.schema)
    bundle_path = resolve(args.bundle)
    values_path = resolve(args.gatekeeper_values)

    try:
        registry = read_registry(resolve(args.registry))
        if not schema_path.is_file():
            raise SourceError(f"{schema_path}: missing")
        schema_current = schema_path.read_text(encoding="utf-8")
        artefacts = [
            (schema_path, schema_current, render_schema(registry, schema_current)),
            (bundle_path, None, render_bundle(registry)),
            (values_path, None, render_gatekeeper_values(registry)),
        ]
    except SourceError as exc:
        print(f"registry-generate: {exc}", file=sys.stderr)
        return 2

    drifted = 0
    for path, preread, wanted in artefacts:
        current = preread
        if current is None:
            current = path.read_text(encoding="utf-8") if path.is_file() else None
        rel = path.relative_to(root) if path.is_relative_to(root) else path

        if args.check:
            if current is None:
                print(f"MISSING  {rel}", file=sys.stderr)
                drifted += 1
            elif current != wanted:
                print(f"DRIFT    {rel}", file=sys.stderr)
                print(_diff(rel, current, wanted), file=sys.stderr, end="")
                drifted += 1
            elif not args.quiet:
                print(f"ok       {rel}")
            continue

        if current == wanted:
            if not args.quiet:
                print(f"ok       {rel}")
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(wanted, encoding="utf-8")
        if not args.quiet:
            print(f"{'wrote' if current is None else 'updated'}    {rel}")

    if drifted:
        print(
            f"\nregistry-generate: {drifted} artefact(s) out of date. "
            "registry/*.yaml is the source of truth — run `tools/registry-generate` "
            "and commit the result; never hand-edit a generated enum.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
